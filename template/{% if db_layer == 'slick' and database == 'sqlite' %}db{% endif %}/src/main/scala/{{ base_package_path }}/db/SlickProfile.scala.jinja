package {{ base_package }}.db

import slick.jdbc.SQLiteProfile

import java.time.Instant

/** The Slick profile for this database, and the column mappings that depend on it. The only database-specific file of the Slick layer.
  */
object SlickProfile {

  val profile: SQLiteProfile.type = SQLiteProfile

  import profile.api.*

  /** SQLite: `integer` epoch milliseconds, like the other DB layers. Import it by name: that shadows the profile's. */
  given instantColumnType: BaseColumnType[Instant] = MappedColumnType.base[Instant, Long](_.toEpochMilli, Instant.ofEpochMilli(_).nn)

}
