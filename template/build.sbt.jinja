{%- set full_stack = components == 'full-stack' -%}
{%- set author = author_name | replace('\\', '\\\\') | replace('"', '\\"') -%}
{%- set header = {
  'MIT': 'HeaderLicense.MIT("' ~ copyright_year ~ '", "' ~ author ~ '", HeaderLicenseStyle.Detailed)',
  'Apache-2.0': 'HeaderLicense.ALv2("' ~ copyright_year ~ '", "' ~ author ~ '")',
  'BSD-3-Clause': 'HeaderLicense.BSD3Clause("' ~ copyright_year ~ '", "' ~ author ~ '")',
  'GPL-3.0': 'HeaderLicense.GPLv3("' ~ copyright_year ~ '", "' ~ author ~ '")',
  'Proprietary': 'HeaderLicense.Custom("Copyright (c) ' ~ copyright_year ~ ' ' ~ author ~ '. All rights reserved.")',
}[license] -%}
// {{ project_name }}. Generated from the full-zio-stack template; AGENTS.md explains how the project is organised.

import Dependencies.*
{%- if full_stack %}
import org.apache.commons.io.FileUtils
import org.scalajs.linker.interface.ModuleSplitStyle
{%- endif %}

lazy val SCALA = "3.9.0"
Global / onChangedBuildSource := ReloadOnSourceChanges
ThisBuild / scalaVersion      := SCALA
ThisBuild / version           := "0.1.0-SNAPSHOT"
ThisBuild / organization      := "{{ organization }}"
{%- if auth == 'zio-auth' %}

// zio-auth is published to GitHub Packages, which needs a token with read:packages even to read: set GITHUB_TOKEN
// (and GITHUB_ACTOR, if your user name is not the one below) before building.
ThisBuild / resolvers += "GitHub Packages rleibman/zio-auth" at "https://maven.pkg.github.com/rleibman/zio-auth"
ThisBuild / credentials += Credentials(
  "GitHub Package Registry",
  "maven.pkg.github.com",
  sys.env.getOrElse("GITHUB_ACTOR", "rleibman"),
  sys.env.getOrElse("GITHUB_TOKEN", ""),
)
{%- endif %}
{%- if packaging != 'none' %}

// sbt-native-packager wires up scopes that this build never reads.
Global / excludeLintKeys ++= Set(
  daemonUser,
  daemonUserUid,
  daemonGroup,
  daemonGroupGid,
  daemonStdoutLogFile,
  executableScriptName,
  SettingKey[File]("rpmScriptletsDirectory"), // not auto-imported by native-packager
  sourceDirectory,
  javaOptions,
  name,
)
{%- endif %}

// caliban and sttp-client4 still ask for an older zio-json than this build uses.
ThisBuild / libraryDependencySchemes ++= Seq(
  "dev.zio" %% "zio-json" % VersionScheme.Always,
{%- if full_stack %}
  "dev.zio"  % "zio-json_sjs1_3" % VersionScheme.Always,
  // The stLib facades were built against older scalajs-react modules than the 4.x this build uses.
  "com.github.japgolly.scalajs-react" % "core_sjs1_3"         % VersionScheme.Always,
  "com.github.japgolly.scalajs-react" % "core-generic_sjs1_3" % VersionScheme.Always,
  "com.github.japgolly.scalajs-react" % "extra_sjs1_3"        % VersionScheme.Always,
  "com.github.japgolly.scalajs-react" % "facade_sjs1_3"       % VersionScheme.Always,
  "com.github.japgolly.scalajs-react" % "util_sjs1_3"         % VersionScheme.Always,
  "com.github.japgolly.scalajs-react" % "callback_sjs1_3"     % VersionScheme.Always,
{%- endif %}
)

lazy val calibanRender = TaskKey[Unit]("calibanRender", "Writes the GraphQL schema to server/src/main/graphql/schema.graphql")
{%- if full_stack %}
lazy val webDist = TaskKey[File]("webDist", "Production build of the client, into dist/")
lazy val webDebugDist = TaskKey[File]("webDebugDist", "Development build of the client, into debugDist/")
{%- endif %}

lazy val scala3Opts = Seq(
  "-Wconf:msg=Implicit parameters should be provided with a `using` clause:s",
  "-deprecation",
  "-no-indent",
  "-old-syntax",
  "-encoding",
  "utf-8",
  "-feature",
  "-language:existentials",
  "-language:implicitConversions",
  "-language:higherKinds",
  "-unchecked",
  "-Werror", // Every warning is an error.
  "-Xmax-inlines",
  "128",
  "-Yexplicit-nulls", // Reference types are non-nullable; Java APIs return `T | Null`.
  "-Yretain-trees",
)

lazy val commonSettings = Seq(
  startYear        := Some({{ copyright_year }}),
  organizationName := "{{ author }}",
  headerLicense    := Some({{ header }}),
  scalacOptions ++= scala3Opts,
)

lazy val testSettings = Seq(
  libraryDependencies ++= Seq(zioTest, zioTestSbt),
  // Testcontainers and the servers under test need their own JVM; sequential keeps container start-up predictable.
  Test / fork              := true,
  Test / parallelExecution := false,
  // Timestamps go through java.sql.Timestamp in the JVM's zone: keep it fixed.
  Test / javaOptions += "-Duser.timezone=UTC",
)

//////////////////////////////////////////////////////////////////////////////////////////////////
// Model: domain types{% if full_stack %} shared by the server and the client{% endif %}
{%- if full_stack %}
lazy val modelJVM = model.jvm
lazy val modelJS = model.js

lazy val model = crossProject(JSPlatform, JVMPlatform)
  .in(file("model"))
  // Headers from the JVM side only: both sides compile the same shared sources, and two projects adding a header to
  // the same file at once corrupt it.
  .jvmConfigure(_.enablePlugins(AutomateHeaderPlugin))
  .settings(
    name := "{{ project_slug }}-model",
    commonSettings,
    libraryDependencies += zioJson,
  )
  .jsSettings(libraryDependencies ++= scalaJavaTime)
{%- else %}
lazy val modelJVM = project
  .in(file("model"))
  .withId("model")
  .enablePlugins(AutomateHeaderPlugin)
  .settings(
    name := "{{ project_slug }}-model",
    commonSettings,
    libraryDependencies += zioJson,
    // Same layout as a cross-built model, so adding a Scala.js client later only changes this file.
    Compile / unmanagedSourceDirectories := Seq(baseDirectory.value / "shared" / "src" / "main" / "scala"),
  )
{%- endif %}

//////////////////////////////////////////////////////////////////////////////////////////////////
// Data services ({{ db_layer }} on {{ database }}) and the Flyway migrations
lazy val db = project
  .in(file("db"))
  .enablePlugins(AutomateHeaderPlugin)
  .dependsOn(modelJVM)
  .settings(
    name := "{{ project_slug }}-db",
    commonSettings,
    testSettings,
    libraryDependencies ++= Seq(zio, hikari, flywayCore, logbackTest) ++ layerLibraries("{{ db_layer }}") ++
      databaseLibraries("{{ database }}"),
  )

{%- if ai == 'langchain4j' %}

//////////////////////////////////////////////////////////////////////////////////////////////////
// AI: the service and its GraphQL fragment (the provider is configuration: app.ai in application.conf)
lazy val ai = project
  .in(file("ai"))
  .enablePlugins(AutomateHeaderPlugin)
  .dependsOn(modelJVM)
  .settings(
    name := "{{ project_slug }}-ai",
    commonSettings,
    testSettings,
    libraryDependencies ++= Seq(zio, calibanCore) ++ langchain4j
  )
{%- endif %}

//////////////////////////////////////////////////////////////////////////////////////////////////
// Server ({{ http_server }}): config, GraphQL API, services, and Main
lazy val server = project
  .in(file("server"))
  .enablePlugins(
    AutomateHeaderPlugin,
    BuildInfoPlugin,
{%- if packaging == 'docker' %}
    JavaAppPackaging,
    DockerPlugin,
{%- elif packaging == 'systemd' %}
    JavaServerAppPackaging,
    SystemdPlugin,
    DebianPlugin,
{%- endif %}
  )
  .dependsOn(modelJVM, db % "compile->compile;test->test"{% if ai == 'langchain4j' %}, ai{% endif %})
  .settings(
    name             := "{{ project_slug }}-server",
    buildInfoPackage := "{{ base_package }}.server",
    // RenderSchema (for calibanRender) is a main class too; this is the one to run and package.
    Compile / mainClass := Some("{{ base_package }}.server.Main"),
    commonSettings,
    testSettings,
    libraryDependencies ++= Seq(zio, calibanCore) ++ zioConfig ++ logging ++ telemetry ++ serverLibraries("{{ http_server }}")
      {%- if auth == 'zio-auth' %} ++ zioAuth{% endif %},
    calibanRender := Def.uncached {
      Def.taskDyn {
        val schemaFile = baseDirectory.value / "src" / "main" / "graphql" / "schema.graphql"
        (Compile / runMain).toTask(s" {{ base_package }}.graphql.RenderSchema $schemaFile")
      }.value
    },
    // SchemaSpec compares the committed schema with the current API.
    Test / javaOptions += s"-Dschema.file=${baseDirectory.value / "src" / "main" / "graphql" / "schema.graphql"}",
    // Run from the project root, so the relative staticContentDir (dist/ or debugDist/) resolves.
    run / fork          := true,
    run / baseDirectory := (ThisBuild / baseDirectory).value,
    run / javaOptions += "-Duser.timezone=UTC",
{%- if packaging == 'docker' %}
    Docker / packageName := "{{ project_slug }}",
    dockerBaseImage      := "eclipse-temurin:21-jre",
    dockerExposedPorts   := Seq({{ http_port }}),
{%- elif packaging == 'systemd' %}
    maintainer         := "{{ author }}{% if author_email %} <{{ author_email }}>{% endif %}",
    packageSummary     := "{{ project_name }}",
    packageDescription := "{{ (description or project_name) | replace('"', '\\"') }}",
{%- endif %}
{%- if packaging != 'none' %}
    Universal / javaOptions += "-J-Duser.timezone=UTC",
{%- if full_stack %}
    // The package includes the production client build, served from dist/. (By project id: referring to the `client`
    // val here, while client refers back to the server's schema, would deadlock the build's initialisation.)
    Universal / mappings ++= {
      given xsbti.FileConverter = fileConverter.value
      com.typesafe.sbt.packager.PluginCompat.toFileRefsMapping(
        com.typesafe.sbt.packager.MappingsHelper.directory((LocalProject("client") / webDist).value)
      )
    },
{%- endif %}
{%- endif %}
  )
{%- if full_stack %}

//////////////////////////////////////////////////////////////////////////////////////////////////
// Web client: Scala.js + scalajs-react + MUI, bundled by vite
/** Links with Scala.js, bundles with `vite build`, then lays the result out beside the static assets. sbt drives vite,
  * not the reverse: the paths vite needs go over in the environment (see client/vite.config.js).
  */
def viteDistImpl(
  viteRoot:      File,
  scalaJSOutput: File,
  assets:        File,
  stagingDir:    File,
  outputFolder:  File,
  mode:          String,
  log:           Logger,
): File = {
  import scala.sys.process.*

  if (!(viteRoot / "node_modules").exists()) {
    log.info(s"node_modules missing, running `npm install` in $viteRoot")
    val installed = Process("npm" :: "install" :: Nil, viteRoot).!
    if (installed != 0) sys.error(s"npm install failed in $viteRoot (exit code $installed)")
  }

  val env = Seq(
    "SCALAJS_OUTPUT_DIR" -> scalaJSOutput.getAbsolutePath,
    "VITE_OUT_DIR"       -> stagingDir.getAbsolutePath,
  )
  log.info(s"vite build --mode $mode (scala.js output: $scalaJSOutput)")
  val built = Process("npx" :: "vite" :: "build" :: "--mode" :: mode :: Nil, viteRoot, env*).!
  if (built != 0) sys.error(s"vite build failed in $viteRoot (exit code $built)")

  // Clear ONLY the bundler's output area; the static copy below re-adds anything of ours under assets/.
  val bundleAssets = outputFolder / "assets"
  if (bundleAssets.exists()) FileUtils.deleteDirectory(bundleAssets)
  outputFolder.mkdirs()
  // index.html comes from vite's output (it carries the hashed <script>), so skip any source copy of it.
  if (assets.exists()) {
    assets.listFiles().foreach { f =>
      if (f.getName != "index.html") {
        if (f.isDirectory) FileUtils.copyDirectory(f, outputFolder / f.getName, true)
        else FileUtils.copyFile(f, outputFolder / f.getName)
      }
    }
  }
  FileUtils.copyDirectory(stagingDir, outputFolder, true)
  outputFolder
}

// The ScalablyTyped facades, published locally from the standalone stLib/ build:
//   cd stLib && npm install && sbt publishLocal
// Bump this together with `version` in stLib/build.sbt.
val stlibVersion = "1.0.0"

lazy val client = project
  .in(file("client"))
  .dependsOn(modelJS)
  .enablePlugins(AutomateHeaderPlugin, ScalaJSPlugin, CalibanPlugin)
  .settings(
    name := "{{ project_slug }}-web",
    commonSettings,
    libraryDependencies ++= clientLibraries ++ scalaJavaTime ++ Seq(
      // Hand-suffixed: coursier cross-versions the local module *directory* to _sjs1_3 but not the jar name.
      "{{ organization }}" % "{{ project_slug }}-stlib_sjs1_3" % stlibVersion,
      {%- if auth == 'zio-auth' %}
      // zio-auth's client half: the login, registration and password-recovery screens (see AuthGate).
      zioAuthClient,
      {%- endif %}
    ),
    dependencyOverrides ++= Seq(
      "com.github.japgolly.scalajs-react" %% "core"  % V.scalajsReact,
      "com.github.japgolly.scalajs-react" %% "extra" % V.scalajsReact,
    ),
    // The GraphQL client is generated on compile from the server's committed schema (see calibanRender).
    Compile / caliban / calibanSources := (ThisBuild / baseDirectory).value / "server" / "src" / "main" / "graphql",
    Compile / caliban / calibanSettings += calibanSetting((ThisBuild / baseDirectory).value / "server" / "src" / "main" / "graphql" / "schema.graphql")(
      _.clientName("{{ class_prefix }}Client").packageName("{{ base_package }}.client.api")
    ),
    // scalajs-react's StBuildingComponent is `inline`, so its call to the deprecated
    // scala.scalajs.runtime.linkingInfo is reported at every call site. Nothing here can fix it.
    scalacOptions += "-Wconf:msg=linkingInfo in package scala.scalajs.runtime is deprecated:s",
    // ES modules, which vite consumes directly; small modules keep incremental links fast.
    scalaJSLinkerConfig ~= {
      _.withModuleKind(ModuleKind.ESModule)
        .withModuleSplitStyle(ModuleSplitStyle.SmallModulesFor(List("{{ base_package }}.client")))
        .withSourceMap(true)
    },
    Global / scalaJSStage                     := FastOptStage,
    Compile / scalaJSUseMainModuleInitializer := true,
    Test / scalaJSUseMainModuleInitializer    := false,
    webDebugDist := Def.uncached {
      viteDistImpl(
        viteRoot = baseDirectory.value,
        scalaJSOutput = (Compile / fastLinkJSOutput).value,
        assets = baseDirectory.value / "src" / "main" / "web",
        stagingDir = target.value / "vite" / "debugDist",
        outputFolder = (ThisBuild / baseDirectory).value / "debugDist",
        mode = "development",
        log = streams.value.log,
      )
    },
    webDist := Def.uncached {
      viteDistImpl(
        viteRoot = baseDirectory.value,
        scalaJSOutput = (Compile / fullLinkJSOutput).value,
        assets = baseDirectory.value / "src" / "main" / "web",
        stagingDir = target.value / "vite" / "dist",
        outputFolder = (ThisBuild / baseDirectory).value / "dist",
        mode = "production",
        log = streams.value.log,
      )
    },
  )
{%- endif %}

//////////////////////////////////////////////////////////////////////////////////////////////////
lazy val root = project
  .in(file("."))
  .aggregate(modelJVM, {% if full_stack %}modelJS, {% endif %}db, {% if ai == 'langchain4j' %}ai, {% endif %}server{% if full_stack %}, client{% endif %})
  .settings(
    name           := "{{ project_slug }}",
    publish / skip := true,
    headerLicense  := None,
  )
