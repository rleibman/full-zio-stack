{%- set url = {
  'mariadb': 'jdbc:mariadb://localhost:' ~ db_port ~ '/' ~ db_name,
  'mysql': 'jdbc:mysql://localhost:' ~ db_port ~ '/' ~ db_name ~ '?allowPublicKeyRetrieval=true&useSSL=false',
  'postgres': 'jdbc:postgresql://localhost:' ~ db_port ~ '/' ~ db_name,
  'sqlite': 'jdbc:sqlite:' ~ sqlite_file ~ '?journal_mode=WAL&busy_timeout=5000',
}[database] -%}
# Every value can be overridden by the environment variable next to it, or the whole file with -Dconfig.file=...
app {
  http {
    host = "0.0.0.0"
    host = ${?HTTP_HOST}
    port = {{ http_port }}
    port = ${?HTTP_PORT}
    # The built client: dist (sbt client/webDist) or debugDist (sbt client/webDebugDist), relative to the working
    # directory.
    staticContentDir = "dist"
    staticContentDir = ${?STATIC_CONTENT_DIR}
  }

  telemetry {
    serviceName = "{{ project_slug }}"
    # OTLP/HTTP endpoint of a collector, e.g. http://localhost:4318. Empty: spans are recorded by a no-op tracer and
    # nothing is exported.
    endpoint = ""
    endpoint = ${?OTEL_EXPORTER_OTLP_ENDPOINT}
  }

{%- if auth == 'zio-auth' %}
  auth {
    # Signs the session tokens. Empty means "generate one at startup", which is fine while you develop but logs
    # everyone out on every restart, so set AUTH_SECRET in production. Anyone who knows it can forge a session.
    secret = ""
    secret = ${?AUTH_SECRET}
    # Where the client is reachable; the links in registration and password-recovery emails point here.
    webHostUrl = "http://localhost:{{ http_port }}"
    webHostUrl = ${?WEB_HOST_URL}
    # How long a session lasts before the client refreshes it, and how long it can be refreshed for.
    sessionMinutes = 60
    refreshMinutes = 1440
    # false so that logging in over plain http works in development. Set it in production, behind https.
    secureCookie = false
  }

{% endif %}
{%- if ai == 'langchain4j' %}
  ai {
    # anthropic, openai, ollama, or none to switch the AI features off.
    provider = "{{ ai_provider }}"
    provider = ${?AI_PROVIDER}
    model = "{{ ai_model }}"
    model = ${?AI_MODEL}
{%- if ai_provider != 'ollama' %}
    # Keep the key out of this file:
    apiKey = ${?AI_API_KEY}
{%- else %}
    # Where Ollama is listening.
    baseUrl = "http://localhost:11434"
    baseUrl = ${?AI_BASE_URL}
{%- endif %}
  }

{% endif %}
  db {
{%- if database == 'sqlite' %}
    # WAL lets readers work while the (single) writer writes; busy_timeout waits for locks instead of failing.
    url = "{{ url }}"
    url = ${?DB_URL}
    # SQLite allows one writer at a time.
    maximumPoolSize = 1
{%- else %}
    # Development defaults, matching {% if dev_compose %}docker-compose.yml{% else %}your local database{% endif %}. Set DB_URL, DB_USER and DB_PASSWORD elsewhere.
    url = "{{ url }}"
    url = ${?DB_URL}
    user = "{{ db_user }}"
    user = ${?DB_USER}
    password = "{{ db_user }}"
    password = ${?DB_PASSWORD}
{%- endif %}
    migrationsLocation = "classpath:db/migration/{{ migration_dir }}"
  }
}
